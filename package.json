{
  "name": "shiv-durga-spices",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,yellow \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"npm run dev --prefix client\"",
    "server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
